# LiveKit Cloud credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# ElevenLabs (TTS) — plugin expects ELEVEN_API_KEY
ELEVEN_API_KEY=

# agent-browser settings
# Base port for dynamic per-session allocation (each session gets a unique port starting here)
AGENT_BROWSER_BASE_STREAM_PORT=10000
AGENT_BROWSER_VIEWPORT_WIDTH=1280
AGENT_BROWSER_VIEWPORT_HEIGHT=720

# Target application URL for onboarding demo
TARGET_APP_URL=https://trytaiga.com

# Narration/screen sync: delay (seconds) before browser action to let TTS finish
PRE_ACTION_DELAY=1.5

# WebSocket proxy URL for agent registration (must match BROWSER_STREAM_PROXY_PORT)
PROXY_REGISTER_URL=http://localhost:9224

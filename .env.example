# ── LiveKit (meetings) ─────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Presenter brain, ears and voice ───────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Default ElevenLabs voice (a presenter can override it in the dashboard)
# ELEVEN_VOICE_ID=

# Model and reasoning effort for the presenting loop
DIRECTOR_MODEL=claude-opus-5-5
# Optional: any Anthropic-compatible provider (DeepSeek, GLM/Z.ai, a gateway).
# Non-Claude models drive the screen through a portable computer tool; they must
# accept images. Check one first with: python scripts/probe_models.py --help
# DIRECTOR_BASE_URL=https://api.deepseek.com/anthropic
# DIRECTOR_API_KEY=
# DIRECTOR_NATIVE=0      # force portable (0) or full Claude features (1); default: by model name
DIRECTOR_EFFORT=medium
# Server-side refusal fallbacks (1 = on)
DIRECTOR_FALLBACKS=1

# ── Research (AI learns the product and drafts the demo) ──────────────────
# Where the dashboard reaches `onboard-researcher serve` (compose sets this).
# RESEARCHER_URL=http://127.0.0.1:8790
# Shared by web and researcher; requests carry demo credentials, so set it.
RESEARCHER_TOKEN=change-me-three
# RESEARCHER_MODEL=claude-opus-5-5
# Same options as the presenter: RESEARCHER_BASE_URL, RESEARCHER_API_KEY, RESEARCHER_NATIVE
# RESEARCHER_EFFORT=high
# Minutes of hands-on exploration per research job
# RESEARCHER_EXPLORE_MINUTES=15
# RESEARCHER_MAX_JOBS=2

# ── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=change-me
# Shared by web and worker so the worker can report session transcripts
AGENT_CALLBACK_SECRET=change-me-too
# PUBLIC_BASE_URL=https://demo.yourcompany.com

# ── Sandbox desktops ───────────────────────────────────────────────────────
# local  - spawn Xvfb + Chromium on this machine per session (Linux dev)
# docker - one container per session (production; see docker-compose.yml)
# static - reuse one running sandbox at SANDBOX_URL (single session only)
SANDBOX_PROVIDER=local
# SANDBOX_URL=http://127.0.0.1:8765
# SANDBOX_TOKEN=
SANDBOX_SIZE=1280x800

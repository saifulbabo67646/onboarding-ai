{
  "name": "onboard-web",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard and live demo pages for Onboarding AI presenters",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import-json": "tsx --conditions=react-server scripts/import-json.ts",
    "auth:generate": "npx -y auth@1.7.7 generate --config lib/server/auth.ts --output lib/server/db/auth-schema.ts --yes",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@livekit/components-react": "2.9.16",
    "@livekit/components-styles": "1.2.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "livekit-client": "2.16.0",
    "livekit-server-sdk": "2.14.2",
    "lucide-react": "^1.55.0",
    "next": "15.2.8",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.6",
    "prettier": "3.7.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.18.2"
}

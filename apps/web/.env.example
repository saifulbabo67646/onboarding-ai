# LiveKit project (https://cloud.livekit.io or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres for users, workspaces, presenters and sessions. Migrations run on start.
DATABASE_URL=postgres://onboard:onboard@localhost:5432/onboard
# Random 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the dashboard is served; Google redirects back to <this>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Encrypts demo-account secrets at rest (32 bytes): openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Optional "Continue with Google" (OAuth client of type "Web application")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional email for invitations and password resets (https://resend.com).
# Without it, links are printed to the server log and shown in the dashboard.
# RESEND_API_KEY=
# EMAIL_FROM=Onboarding AI <hello@yourcompany.com>

# Shared secret the presenter worker uses to report session events (must match the agent).
AGENT_CALLBACK_SECRET=
# Base URL the worker can reach this app on (defaults to the visitor's origin).
# AGENT_CALLBACK_BASE_URL=http://web:3000

# Public origin used for share links (defaults to the request host).
# PUBLIC_BASE_URL=https://demo.yourcompany.com

# Abuse limits for the public join page.
# JOIN_LIMIT_PER_IP=6
# JOIN_LIMIT_WINDOW_MINUTES=10
# MAX_CONCURRENT_SESSIONS_PER_PRESENTER=10

# Set to 0 to skip running migrations on start (then run `pnpm db:migrate` yourself).
# DATABASE_AUTO_MIGRATE=1

# Must match AGENT_NAME of the worker.
# AGENT_NAME=onboarding-agent

# The research service (onboard-researcher serve) that drafts demos from a URL.
# RESEARCHER_URL=http://127.0.0.1:8790
# RESEARCHER_TOKEN=

# LiveKit project (https://cloud.livekit.io or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dashboard password for owners. Leave empty only for local development.
DASHBOARD_PASSWORD=

# Shared secret the presenter worker uses to report session events (must match the agent).
AGENT_CALLBACK_SECRET=
# Base URL the worker can reach this app on (defaults to the visitor's origin).
# AGENT_CALLBACK_BASE_URL=http://web:3000

# Public origin used for share links (defaults to the request host).
# PUBLIC_BASE_URL=https://demo.yourcompany.com

# Where agents and sessions are stored (JSON file store).
# DATA_DIR=./.data

# Must match AGENT_NAME of the worker.
# AGENT_NAME=onboarding-agent

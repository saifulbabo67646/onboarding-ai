# ── LiveKit (meetings) ─────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Presenter brain, ears and voice ───────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Default ElevenLabs voice (a presenter can override it in the dashboard)
# ELEVEN_VOICE_ID=

# Model and reasoning effort for the presenting loop
DIRECTOR_MODEL=claude-opus-5
DIRECTOR_EFFORT=medium
# Server-side refusal fallbacks (1 = on)
DIRECTOR_FALLBACKS=1

# ── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=change-me
# Shared by web and worker so the worker can report session transcripts
AGENT_CALLBACK_SECRET=change-me-too
# PUBLIC_BASE_URL=https://demo.yourcompany.com

# ── Sandbox desktops ───────────────────────────────────────────────────────
# local  - spawn Xvfb + Chromium on this machine per session (Linux dev)
# docker - one container per session (production; see docker-compose.yml)
# static - reuse one running sandbox at SANDBOX_URL (single session only)
SANDBOX_PROVIDER=local
# SANDBOX_URL=http://127.0.0.1:8765
# SANDBOX_TOKEN=
SANDBOX_SIZE=1280x800
